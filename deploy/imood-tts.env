# Installed to /etc/imood-tts.env — edit then: sudo systemctl restart imood-tts
# (this file is read by the imood-tts systemd unit; env vars for tts_service.py)

# --- model / backend -------------------------------------------------------
COSYVOICE_REPO=/root/CosyVoice
COSYVOICE_MODEL_DIR=/root/CosyVoice/pretrained_models/CosyVoice2-0.5B
MODELSCOPE_OFFLINE=1

# --- output volume -------------------------------------------------------
# _level() in tts_service.py: optional tanh soft-saturation (TTS_DRIVE) to tame
# peaks, then per-~2s-chunk RMS-normalise to TTS_RMS_DBFS holding peaks under
# TTS_PEAK_DBFS (soft-knee above, no hard clip).
#   quieter        -> TTS_RMS_DBFS=-16, TTS_DRIVE=1.0
#   current        -> as below (~ -12 dBFS RMS, clearly loud, still clean)
#   louder still   -> TTS_DRIVE=3.0  (past ~3.5 it starts sounding nasal/hard)
# TTS_NORMALIZE=0 disables normalisation (falls back to plain TTS_GAIN).
TTS_DRIVE=2.2
TTS_RMS_DBFS=-12.0
TTS_PEAK_DBFS=-1.0
# TTS_GAIN=1.0
# TTS_NORMALIZE=1

# --- voice (zero-shot reference) ----------------------------------------
# Swap these two to change the voice — no code change. Give a 3-10s clean wav
# and its exact transcript. Restart the service after changing.
# TTS_PROMPT_WAV=/root/CosyVoice/asset/zero_shot_prompt.wav
# TTS_PROMPT_TEXT=希望你以后能够做的比我还好呦。
